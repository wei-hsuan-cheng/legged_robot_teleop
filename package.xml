<?xml version="1.0"?>
<package format="3">
  <name>legged_robot_teleop</name>
  <version>0.1.0</version>
  <description>Gamepad velocity and base-height commands for legged robot MPC.</description>
  <maintainer email="johnathancheng0125@gmail.com">Wei-Hsuan Cheng</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ocs2_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
